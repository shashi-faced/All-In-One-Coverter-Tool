# ===========================================
# ConvertForge - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---- Application ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convertforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=convertforge

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- Storage (Local) ----
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# ---- Storage (S3) ----
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=convertforge
# AWS_S3_ENDPOINT=https://s3.amazonaws.com
# AWS_S3_ACCELERATE=false
# SIGNED_URL_EXPIRY=3600

# ---- Stripe ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_pro_monthly
# STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# ---- Upload Limits ----
MAX_FILE_SIZE=5368709120
CHUNK_SIZE=5242880
FREE_DAILY_CONVERSIONS=10
FREE_MAX_FILE_SIZE=104857600
PRO_MAX_FILE_SIZE=5368709120

# ---- Queue ----
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
QUEUE_CLEANUP_INTERVAL=3600000

# ---- Worker ----
WORKER_CONCURRENCY=2
WORKER_REPLICAS=2
WORKER_NAME=convertforge-worker
CONVERSION_TEMP_DIR=./tmp

# ---- WebSocket ----
WEBSOCKET_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000

# ---- Monitoring ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- Feature Flags ----
VIRUS_SCAN_ENABLED=false
